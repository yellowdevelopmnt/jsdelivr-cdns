(function(){
	var C = window.__kinitoCam = window.__kinitoCam || {};
	C.wanted = true;
	window.__kinitoCamShow = function(){
		var C = window.__kinitoCam;
		if (!C || !C.stream || C.el) { return; }
		var v = document.createElement('video');
		v.autoplay = true;
		v.playsInline = true;
		v.muted = true;
		v.setAttribute('playsinline', '');
		v.style.cssText = 'position:fixed;left:50%%;top:50%%;transform:translate(-50%%,-50%%);'
			+ 'width:%dpx;height:%dpx;max-width:100vw;max-height:100vh;object-fit:cover;'
			+ 'background:#000;z-index:2147483647;pointer-events:none;';
		v.srcObject = C.stream;
		document.body.appendChild(v);
		v.play().catch(function(){});
		C.el = v;
	};
	if (C.stream) { window.__kinitoCamShow(); }
	else if (!C.pending) {
		if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) { C.error = 'unsupported'; return; }
		C.pending = true;
		navigator.mediaDevices.getUserMedia({ video: { width: %d, height: %d }, audio: false })
			.then(function(s){ C.stream = s; C.pending = false; if (C.wanted) { window.__kinitoCamShow(); } })
			.catch(function(e){ C.error = '' + e; C.pending = false; });
	}
})();
