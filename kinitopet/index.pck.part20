[sub_resource type="GDScript" id=25]
script/source = "extends Node
var games = {}
var rawGameList = []
func _ready():
	
	if _getGames():
		var inputName = \"fail\"
		if Vars.get(\"HOUSE_favgame\") != null:
			inputName = true_game_name(str(Vars.get(\"HOUSE_favgame\")))
		if inputName != \"fail\":
			Vars.set(\"HOUSE_GamesValid\",true)
			get_parent().get_node(\"[desc] A shelf full of your favourite games\").translation.y = 0
			var key = getKeyFromGame(inputName)
			if key != \"-1\":
				var _name = getGameName(key)
				var header = \"https://cdn.cloudflare.steamstatic.com/steam/apps/\"+str(key)+\"/capsule_616x353.jpg\"
				get_parent().get_node(\"[desc] An office just for you\").name = \"[desc] Its playing your favourite game, \"+_name
				print(key)
				$TVSCREEN/urlTexture._getImageFromURL(str(header))
				var case = \"https://cdn.cloudflare.steamstatic.com/steam/apps/\"+str(key)+\"/library_600x900.jpg\"
				$Cap0/urlTexture._getImageFromURL(str(case))
				
				
				get_parent().get_node(\"GamerWall\").visible = true
				
				var wallpaper = \"https://cdn.cloudflare.steamstatic.com/steam/apps/\"+str(key)+\"/page_bg_raw.jpg\"
				$BG/urlTexture._getImageFromURL(str(wallpaper))
				
				
				games.erase(key)
			
			
			var capAMT = 0
			for keynum in games.keys():
				capAMT += 1
				if capAMT < 10:
					if capAMT == 3:
						pass
						
					var nextcase = \"https://cdn.cloudflare.steamstatic.com/steam/apps/\"+str(keynum)+\"/library_600x900.jpg\"
					get_node(\"Cap\"+str(capAMT)+\"/urlTexture\")._getImageFromURL(str(nextcase))
					get_parent().get_node(\"Capsule\").get_node(str(capAMT)).visible = true
				
			pass
		else:
			Vars.set(\"HOUSE_GamesValid\",false)
	pass

func _getGames():
	var runok = false
	var result = OS.get_environment(\"APPDATA\") + \"/Microsoft/Windows/Start Menu/Programs/Steam\".replace(\"/\",\"\\\\\")
	var dir = Directory.new()
	if dir.open(result) == OK:
		dir.list_dir_begin()
		while true:
			var item = dir.get_next()
			if item == \"\":
				break
			if not dir.current_is_dir():  # Check if the current item is a file
				if \".url\" in item: 
					var fileInfo = ($IconExtracter._url((result+\"/\"+item).replace(\"/\",\"\\\\\")))
					
					var gameID = str(int(float((fileInfo.split(\"URL=\")[1].split(\"\\n\")[0].split(\"\\n\")[0].replace(\"steam://rungameid/\",\"\")))))
					
					var additem = item.replace(\".url\",\"\").split(\" - \")[0].replace(\"DLC\", \"\").replace(\"Demo\", \"\").replace(\"'\", \"\")
					var splitItem = additem.replace(\"-\", \" \").split(\" \")
					runok = true
					if splitItem.size() > 2:
						var acronym = \"\"
						for i in range(splitItem.size()):
							acronym += str(splitItem[i].left(1))
						rawGameList.append(acronym)
						games[gameID] = [additem,acronym]
					else:
						games[gameID] = [additem]
					rawGameList.append(additem)
				#print(item)  # This is the name of a folder
		dir.list_dir_end()
	else:
		print(\"Failed to open directory:\", result)
	return runok


func true_game_name(input):
	var gameName = \"fail\"
	var closestMatch = findClosestMatch(input.to_lower().replace(\" \",\"\").replace(\"-\",\"\"), rawGameList)
	if closestMatch != \"\":
		gameName = closestMatch
	return gameName


func findClosestMatch(input: String, array: Array) -> String:
	var closestDistance = len(input)  # Initialize with maximum possible distance
	var closestMatch = \"\"
	
	for item in array:
		var distance = levenshteinDistance(input, item.to_lower().replace(\" \",\"\").replace(\"-\",\"\"))
		if distance < closestDistance:
			closestDistance = distance
			closestMatch = item
			
	return closestMatch

func levenshteinDistance(a: String, b: String) -> int:
	var dp = []
	for i in range(a.length() + 1):
		dp.append([])
		for j in range(b.length() + 1):
			dp[i].append(0)
			
	for i in range(a.length() + 1):
		dp[i][0] = i
		
	for j in range(b.length() + 1):
		dp[0][j] = j
		
	for i in range(1, a.length() + 1):
		for j in range(1, b.length() + 1):
			if a[i - 1] == b[j - 1]:
				dp[i][j] = dp[i - 1][j - 1]
			else:
				dp[i][j] = min(dp[i - 1][j], dp[i][j - 1]) + 1
				
	return dp[a.length()][b.length()]



func getGameName(key) -> String:
	return games[key][0]

func getKeyFromGame(gameName: String):
	for key in games.keys():
		if games[key].find(gameName) >= 0:
			return key
	return -1
"

[sub_resource type="GDScript" id=26]
script/source = "extends Node
export var jpg = true

func _getImageFromURL(url):
	var http_request = HTTPRequest.new()
	add_child(http_request)
	http_request.connect(\"request_completed\", self, \"_http_request_completed\")

	# Perform the HTTP request. The URL below returns a PNG image as of writing.
	var error = http_request.request(url)
	if error != OK:
		print(\"An error occurred in the HTTP request.\")


# Called when the HTTP request is completed.
func _http_request_completed(result, response_code, headers, body):
	var image = Image.new()
	var error = null
	if jpg:
		error = image.load_jpg_from_buffer(body)
	else:
		error = image.load_png_from_buffer(body)
	if error != OK:
		print(\"Couldn't load the image.\")

	var texture = ImageTexture.new()
	texture.create_from_image(image)

	# Display the image in a TextureRect node.
	$TextureRect.texture = texture
