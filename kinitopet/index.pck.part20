[sub_resource type="GDScript" id=16]
script/source = "extends RichTextLabel
var textvisi = 0
func _process(delta):
	
	if self.visible:
		if visible_characters > textvisi:
			textvisi = visible_characters
			if text[visible_characters] != \" \":
				$textclick.pitch_scale = rand_range(0.8 , 1.1)
				$textclick.play()
		else:
			textvisi = 0
	else:
		textvisi = 0
"

