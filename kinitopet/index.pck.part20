(function(){
	if (window.__kinitoKeepRunning) { return; }
	if (!window.requestAnimationFrame) { return; }
	var TICK_MS = ␀␀␀␀␀•␀␀;
	var real = window.requestAnimationFrame.bind(window);
	var pending = [];
	var worker = null;

	var lastTick = 0;
	function drain(){
		if (!pending.length) { return; }
		var now = (window.performance && performance.now) ? performance.now() : Date.now();
		// Two independent clocks feed this; do not let them run the game faster
		// than it would run in the foreground.
		if (now - lastTick < TICK_MS * 0.5) { return; }
		lastTick = now;
		var due = pending;
		pending = [];
		for (var i = 0; i < due.length; i++) {
			// One throwing callback must not take the loop down with it.
			try { due[i](now); } catch (err) {}
		}
	}

	// The clock that survives throttling. Silent, and only ever drives the loop
	// while the tab is hidden - the real rAF is better when it is not.
	var actx = null;
	function startAudioClock(){
		if (actx !== null) { return; }
		try {
			var AC = window.AudioContext || window.webkitAudioContext;
			if (!AC) { return; }
			actx = new AC();
			var node = actx.createScriptProcessor(1024, 1, 1);
			node.onaudioprocess = function(){ if (document.hidden) { drain(); } };
			var mute = actx.createGain();
			mute.gain.value = 0;
			node.connect(mute);
			mute.connect(actx.destination);
		} catch (e) { actx = null; }
	}
	function unlockAudioClock(){
		startAudioClock();
		if (actx !== null && actx.state !== 'running' && actx.resume) { actx.resume(); }
	}
	// An AudioContext starts suspended until a gesture, same as the game's own.
	window.addEventListener('mousedown', unlockAudioClock, true);
	window.addEventListener('keydown', unlockAudioClock, true);
	window.addEventListener('touchstart', unlockAudioClock, true);
	unlockAudioClock();

	try {
		var src = "var t=null;onmessage=function(e){"
			+ "if(e.data==='start'){if(t===null){t=setInterval(function(){postMessage(0);}," + TICK_MS + ");}}"
			+ "else{if(t!==null){clearInterval(t);t=null;}}};";
		worker = new Worker(URL.createObjectURL(new Blob([src], {type: 'text/javascript'})));
		worker.onmessage = drain;
	} catch (e) {
		worker = null;
	}

	window.requestAnimationFrame = function(cb){
		if (!document.hidden) { return real(cb); }
		pending.push(cb);
		// No worker available: a page timer is throttled hard in the background,
		// but a slow game still beats a stopped one.
		if (worker === null) { return setTimeout(drain, TICK_MS); }
		return 0;
	};

	function sync(){
		if (worker !== null) { worker.postMessage(document.hidden ? 'start' : 'stop'); }
		if (document.hidden) { return; }
		// Hand anything queued while hidden straight to the real rAF. Draining it
		// here instead would go through the rate limit above, and a skipped drain
		// leaves the callback queued with nothing left to run it - the loop stops
		// dead on the frame the tab comes back.
		var due = pending;
		pending = [];
		for (var i = 0; i < due.length; i++) { real(due[i]); }
	}
	document.addEventListener('visibilitychange', sync);
	sync();
	window.__kinitoKeepRunning = true;
})();
