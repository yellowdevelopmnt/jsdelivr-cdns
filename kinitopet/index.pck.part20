(function(){
	if (window.__kinitoLock) { return; }
	var S = window.__kinitoLock = { want:false, hide:false };
	function canvas(){ return document.getElementById('canvas') || document.querySelector('canvas'); }
	S.apply = function(){
		var c = canvas();
		if (!c) { return; }
		if (S.hide && !document.pointerLockElement) { c.style.cursor = 'none'; }
	};
	S.relock = function(){
		if (!S.want || document.pointerLockElement) { return; }
		var c = canvas();
		if (c && c.requestPointerLock) { try { c.requestPointerLock(); } catch (e) {} }
	};
	// Capture phase, and on window rather than the canvas, so nothing downstream
	// can swallow it. This is the only place a lock request is inside a gesture.
	//
	// Both halves of the click are needed. mousedown covers the case where the
	// game already wanted the mouse (the hide-and-seek scenes ask in _ready()).
	// mouseup covers click-to-recapture: there the game only decides it wants the
	// mouse while handling that very click, which Godot does a frame later - by
	// then mousedown has been and gone, and without this the first click would
	// merely arm the flag and the player would have to click a second time.
	window.addEventListener('mousedown', function(){ S.relock(); S.apply(); }, true);
	window.addEventListener('mouseup', function(){ S.relock(); S.apply(); }, true);
	// A release the engine asked for means the game is done with the mouse.
	// A release the browser performed on its own does not come through here.
	var exit = document.exitPointerLock;
	if (exit) {
		document.exitPointerLock = function(){
			S.want = false;
			return exit.apply(document, arguments);
		};
	}
	document.addEventListener('pointerlockchange', function(){ S.apply(); });
	document.addEventListener('visibilitychange', function(){ S.apply(); });
	window.addEventListener('focus', function(){ S.apply(); });
})();
