[sub_resource type="GDScript" id=1]
script/source = "extends Node2D

# Lense.exe, which shipped as its own little executable in extra/lense/ and ran
# as a separate always-on-top, per-pixel-transparent 600x400 window floating over
# the desktop. It is a magnifying glass: an \"entry\" sits at a fixed spot on the
# SCREEN, invisible, and is only revealed where this window happens to be over
# it - so the player drags the window around hunting for it.
#
# There is no second process and no second window here, so it is drawn inside the
# game instead (App.openLense()). Everything else is as it was: the two halves
# still talk through user://Kinitopet_DATA/ENTRY.get and ENTRY.send, which is what
# Tab._sendEntry() and Tab._on_EntryTimer_timeout() read and write.

const SafeSave = preload(\"res://Script/SafeSave.gd\")

var entry = 0
var last = -1

func _ready():
	if App.singleWindow:
		# The window is App's to size, place and title; touching the real one here
		# would reconfigure the whole game. The scale that follows was compensating
		# for the desktop's resolution - the virtual screen is always 1920 wide, so
		# it is exactly 1.
		$Plane.scale = Vector2(1, 1)
		# The glass tint is a 139662x82814 ColorRect, and a ColorRect stops mouse
		# input by default. rect_clip_content only clips DRAWING, so while it looked
		# confined to the window it was still swallowing every click for most of the
		# screen below and to the right of it. It is decoration; it wants no input.
		$ColorRect.mouse_filter = Control.MOUSE_FILTER_IGNORE
		return

	OS.window_size = Vector2(600,400)* (OS.get_screen_size().x /1920)
	OS.center_window()
	OS.max_window_size = Vector2(600,400)*(OS.get_screen_size().x /1920)

	OS.set_window_title(\"Lense.exe\")
	OS.set_window_always_on_top(true)
	OS.window_per_pixel_transparency_enabled = true
	get_tree().get_root().set_transparent_background(true)

	$Plane.scale = Vector2(OS.get_screen_size().x / 1920, OS.get_screen_size().x /1920)

func _process(delta):
	if App.singleWindow:
		# Plane holds its children at SCREEN coordinates - that is the whole trick,
		# an entry parked at a fixed spot on the desktop that only shows through the
		# glass. Pinning Plane's origin to the viewport origin keeps its children in
		# screen space wherever the window has been dragged to, which is exactly what
		# -OS.window_position did when this really was a window.
		$Plane.global_position = Vector2.ZERO
	else:
		$Plane.position = -OS.window_position
	if App.singleWindow:
		_clipEntryInput()
	if last != entry:
		last = entry
		$Plane/Pos.play(str(entry))


func _clipEntryInput():
	# The entry sits at a fixed spot on the screen and is only DRAWN where the
	# glass is over it - but clipping is a drawing rule, not an input one, so its
	# button stayed clickable through the whole screen. That let the player collect
	# an entry they had never actually found, and blocked whatever was underneath.
	# Only live while it is really showing through the lens.
	var glass = get_parent()
	if not (glass is Control):
		return
	var button = $Plane/Entry/Button
	var box = button.get_global_rect()
	var showing = glass.get_global_rect().intersects(box) and $Plane/Entry.visible
	button.mouse_filter = Control.MOUSE_FILTER_STOP if showing else Control.MOUSE_FILTER_IGNORE

func _on_Button_button_up():
	$Plane/Entry/Click_A.play(\"C\")
	_sendEntry()
	_createEntry()

func _entryFile():
	return \"user://Files/\"+str((str(entry)+SafeSave._key()).sha1_text()).left(15)+\".encrypted\"

func _sendEntry():
	var dir = Directory.new()
	dir.open(\"user://\")
	if(dir.file_exists(\"Kinitopet_DATA\") == false):
		dir.make_dir(\"Kinitopet_DATA\")
	# SafeSave, not a bare open_encrypted_with_pass: it is what Tab writes and reads
	# these two files with, and it caches OS.get_unique_id() - which HTML5 does not
	# implement and which logs an engine error on every single call.
	SafeSave.write_var(\"user://Kinitopet_DATA/ENTRY.send\", entry)
	dir.remove(\"user://Kinitopet_DATA/ENTRY.get\")

func _createEntry():
	var dir = Directory.new()
	dir.open(\"user://\")
	if(dir.file_exists(\"Files\") == false):
		dir.make_dir(\"Files\")
	var target = _entryFile()
	if dir.file_exists(target):
		return
	if entry < 3:
		# Entries 1 and 2 are not text at all - extra/lense/s1.file is Ogg Vorbis
		# audio and s2.file is a PNG, both handed over with a misleading extension
		# for the player to figure out. They were copied in with a shell \"copy\";
		# there is no shell here, so the bytes are read out of the build and
		# written across verbatim.
		var src = File.new()
		if src.open(\"res://Lense/s\" + str(entry) + \".file\", File.READ) != OK:
			printerr(\"Lense: missing res://Lense/s\" + str(entry) + \".file\")
			return
		var payload = src.get_buffer(src.get_len())
		src.close()
		var out = File.new()
		out.open(target, File.WRITE)
		out.store_buffer(payload)
		out.close()
		return
	var string = \"https://www.kinitopet.com/data\"
	if entry == 4:string = \"https://www.kinitopet.com/email\"
	elif entry >= 5:string = \"https://www.kinitopet.com/epanalamvano\"
	var file = File.new()
	file.open(target, File.WRITE)
	file.store_var(string)
	file.close()

func _on_Timer_timeout():
	var dir = Directory.new()
	dir.open(\"user://\")
	if(dir.file_exists(\"Kinitopet_DATA/ENTRY.get\")):
		var got = SafeSave.read_var(\"user://Kinitopet_DATA/ENTRY.get\", null)
		if got != null:
			entry = got
			print(\"new entry:\",entry)
"

