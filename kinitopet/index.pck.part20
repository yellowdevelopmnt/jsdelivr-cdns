(function(){
	var C = window.__kinitoCam;
	if (!C) { return; }
	C.wanted = false;
	if (C.el && C.el.parentNode) { C.el.parentNode.removeChild(C.el); }
	C.el = null;
	if (C.stream) {
		C.stream.getTracks().forEach(function(t){ t.stop(); });
		C.stream = null;
	}
})();
