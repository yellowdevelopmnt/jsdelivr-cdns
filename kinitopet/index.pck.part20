[sub_resource type="GDScript" id=1]
script/source = "extends Node
var active = false
func _input(event):
	if event.is_action_pressed(\"Time\"):
		Engine.time_scale = 10
		active = true
	if event.is_action_released(\"Time\"):
		active = false
		Engine.time_scale = 1
"

[node name="Time" type="Node"]
script = SubResource( 1 )
