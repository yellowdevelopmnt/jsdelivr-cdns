	"player_height": 40,
	"player_sneak_height": 20,
	
	"theme_intro": ["musIntro.ogg", 1],
	"theme_game_over": ["sfxGameOver.ogg", 1],
	"theme_victory": ["sfxVictory.ogg", 1],
	"theme_victory_night5": ["sfxVictory5.ogg", 1],
