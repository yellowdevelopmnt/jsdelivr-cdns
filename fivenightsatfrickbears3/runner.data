õ_Í·-»×	Œ˜r«p†~û	èîßÒâ”:¾f•;çL_9Ù+-ngâÉÙec.-g¼Ûc¶¾]k@sJÀ=àS|N¾£@lÕy´í5ÎœØjbéQÜŠİQÿ#b«1tÖÿˆ…d¥^B␀T␀␀␀␀IEND®B`‚{"DIALOGUE":
	[
		["LISTEN.", "X"],
		["ALL YOU ARE, EVERYTHING YOU HOLD, ALL YOU DO.", "X"],
		["IT'S IMPRESSIVE.", "X"],
		["I WOULD SAY KEEP THEM, KEEP PLAYING FOREVER AND EVER AND EVER, BUT I'M NOT ALLOWED TO.", "X"],
		["YOU MUST LET THEM GO, IF YOU TRULY CARE ABOUT THEM. SOMETIMES YOU HAVE TO LET A FEW VESSELS GO.", "X"],
		["...Vessels?", "Cassidy"],
		["AND GUESS WHAT? YOU'LL GET TO FOLLOW THEM. WHEN IT'S ALL OVER AND YOU GET TO THE OTHER SIDE.", "X"],
		["I'LL BE THERE!", "X"],
		["...But, after all that I did...", "Cassidy"],
		["...Would they even st-still want to be my friends anymore?", "Cassidy"],
		["YOU HAVE TO TAKE THAT CHANCE.", "X"],
		["EVEN IF IT SCARES YOU.", "X"],
		["SHOW THEM YOUR INSIDES. SHOW THEM HOW YOU FEEL. MAKE THEM KNOW.", "X"],
		["BECAUSE I KNOW YOU STILL CARE ABOUT THOSE PEOPLE. YOU WOULDN'T BE DOING THIS IF YOU DIDN'T CARE.", "X"],
		["THEY'LL HATE YOUR GUTS, I BET IT, BUT IF YOU SHOW THEM WHAT YOU FEEL, THINGS CAN GO DIFFERENTLY..", "X"],
		["YOU CAN BE THERE FOR THEM, AND THEY CAN BE THERE FOR YOU. YOU HAVE TO SHOW YOUR GUTS TO THEM FIRST THOUGH.", "X"],
		["YOU'LL GO FAR IF YOU DO THAT.", "X"],
		["SO STAND UP.", "X"],
		["I...", "Cassidy"],
		["...", "Cassidy"],
		["...You're right.", "Cassidy"],
		["It...it isn't right to keep them all down here.", "Cassidy"],
		["...It isn't right to keep myself down here.", "Cassidy"],
		["Whatever's there for us after everything's over...they're still my friends. At least, I still believe that...", "Cassidy"],
		["...Still, I...I don't like saying goodbye.", "Cassidy"],
		["I'll...I'll see you again someday, won't I?", "Cassidy"],
		["I'M CLOSER THEN YOU THINK.", "X"],
		["SO MUCH CLOSER.", "X"],
		["...Okay.. Yeah, okay...", "Cassidy"],
		["It's...", "Cassidy"]
	]
}{"DIALOGUE":
	[
		["There's...two people outside?", ""],
		["...It seems that they're arguing.", ""],
		["_func",
			[
				["addActor", 5, "sTalksprites_Michael"], 
				["playMusic", "musMidnight_MissingChild", 1], 
				["fadeMusic", "musMidnight_MissingChild", 1, 0]
			]
		],
		
		["If you knew what was good for you, you'd leave IT to me. Neither of you have any idea what you're getting yourselves into here.", "Hooded Man"],
		["_func", [["switchActor", [6, 1], "sTalksprites_Vanny"]]],
		["What, so YOU can boss it around? Fat chance! You REEK of ulterior motives!", "White Rabbit"],
		["_func", [["setActor", 7]]],
		["...In fact, you reek in general. Jeez, why do you smell like that?", "White Rabbit"],
		["HELLO.", "X"],
		["_skip"],
		["_func", [["switchActor", [1, 0]]]],
		["...Ah, there you are! Yes, I was hoping to-", "Hooded Man"],
		["_func", [["switchActor", [2, 1]]]],
		["Well hel-LO there, uh.... sir.. You're just who I wanted to see!", "White Rabbit"],
		["_func", [["switchActor", [5, 0]]]],
		["Wha- Hey, I was talking!", "Hooded Man"],
		["_func", [["switchActor", [3, 1]]]],
		["Ladies first, stinky! It's not like you had anything worthwhile to say, anyhow...", "White Rabbit"],
		["WILL YOU CONTINUE TO FIGHT OR WILL YOU TELL ME WHAT YOU WANT?", "X"],
		["_func", [["setActor", 0]]],
		["Well boy, am I GLAD you asked! See, you've got a little something I want.", "White Rabbit"],
		["_func", [["setActor", 2]]],
		["...Well, you got a LOT, actually, but whatever that other stuff you brought home with you was doesn't matter to me right now.", "White Rabbit"],
		["_func", [["setActor", 5]]],
		["You know that green, moldy bunny guy you salvaged? See, funny thing...he actually belongs to ME.", "White Rabbit"],
		["_func", [["switchActor", [2, 0]]]],
		["Under what circumstances!? You know neither of you should be handling that...that thing!", "Hooded Man"],
		
		["_func", [["setActor", 1]]],
		["Listen, er...what was your name?", "Hooded Man"],
		["X.", "X"],
		["_func", [["setActor", 0]]],
		["...X? That's it?.. Alright, well.", "Hooded Man"],
		["_func", [["setActor", 1]]],
		["I apologize if we got off on the wrong foot, but I only want to make one thing clear.", "Hooded Man"],
		["_func", [["setActor", 3]]],
		["Certain things at this company are not to be trifled with. That rabbit is very much one of them.", "Hooded Man"],
		["_func", [["switchActor", [2, 1]]]],
		["...Do you mean Springtrap, or do you mean me?", "White Rabbit"],
		["_func", [["switchActor", [0, 0]]]],
		["I understand that you're new around here. Consider yourself lucky that you still have time to change course.", "Hooded Man"],
		["_func", [["setActor", 4]]],
		["Being around as long as I have, I know I have my share fair of regrets. If I were in your shoes, well...", "Hooded Man"],
		["_func", [["setActor", 0]]],
		["...I would've loved to get out while I still had the chance.", "Hooded Man"],
		["_func", [["switchActor", [4, 1]]]],
		["Are you...threatening that thing?", "White Rabbit"],
		["IT'S NOT WORKING IF YOU ARE.", "X"],
		["_skip"],
		["_func", [["switchActor", [1, 0]]]],
		["I am only warning you. Both of you.", "Hooded Man"],
		
		["_func", [["setActor", 5]]],
		["If you continue down this path, touching things that should not be touched...", "Hooded Man"],
		["_func", [["setActor", 3]]],
		["...I feel you won't be happy when they come back to bite you.", "Hooded Man"],
		["_func", [["switchActor", [5, 1]]]],
		["Tch...you would know a thing about bites, wouldn't you?", "White Rabbit"],
		["_func", [["switchActor", [0, 0]]]],
		["...Excuse me?", "Hooded Man"],
		["_func", [["switchActor", [2, 1]]]],
		["Oh, c'mon, what's with that look? It was just a joke...", "White Rabbit"],
		["_func", [["setActor", 3]]],
		["Oh well...you get the picture, don't you, X?", "White Rabbit"],
		["_func", [["setActor", 0]]],
		["You've got two choices here! You can go along with me...or you can bore yourself to death with whatever THAT guy's got planned.", "White Rabbit"],
		["_func", [["setActor", 1]]],
		["I have a feeling you'll make the right choice in the end.", "White Rabbit"],
		["_func",
			[
				["setObject", "oTalksprite", "sprite_index", [true, "sNOTHING"]],
				["removeActor"],
				["fadeMusic", "musMidnight_MissingChild", 0, 1000]
			]
		],
		
		["...And, just like that, the mysterious white rabbit hopped, skipped and jumped back into the darkness.", ""],
		["_func",[["addActor", 4, "sTalksprites_Michael"]]],
		["...Phew. Good riddance.", "Hooded Man"],
		["_func", [["setActor", 1]]],
		["Listen, er...X, was it?", "Hooded Man"],
		["_func", [["setActor", 2]]],
		["I WOULD like to believe you have good intentions with...whatever it is you're doing here.. Though, judging by.. you. that's not the case.", "Hooded Man"],
		["_func", [["setActor", 3]]],
		["Though, I appreciate that you brought that mask back with you. If you happen to find any more, I would love to take them off your hands.", "Hooded Man"],
		["_func", [["setActor", 0]]],
		["Just.. I don't know.", "Hooded Man"],
		["_func", [["setActor", 4]]],
		["Make the right choice, for everyones sake.", "Hooded Man"],
		["_func",[["removeActor"]]],
		
		["...And the hooded man takes his leave as well.", ""],
		["HOW.. CURIOUS.", "X"],
		["IF THIS IS HOW THINGS WILL KEEP GOING.. I MIGHT JUST KEEP DOING IT.", "X"],
		["THIS IS FUN! I LOVE THE RUSH SO WHY NOT?", "X"],
		["WE'LL KEEP HAVING OUR FUN. YOU AND ME.", "X"],
		["SO LET'S GO.", "X"],
		["_func", [["salvage"]]]
	]
}{"DIALOGUE":
	[
		["...That man from last night is back.", ""],
		["_func",
			[
				["addActor", 2, "sTalksprites_Michael"], 
				["playMusic", "musMidnight_Michael", 1], 
				["fadeMusic", "musMidnight_Michael", 1, 0]
			]
		],
		
		["You know...I can't help but wonder what it is you're trying to accomplish here.", "Hooded Man"],
		["I WANT TO HAVE FUN. THIS BRINGS ME JOY. I LIKE TO FEEL THE RUSH.", "X"],
		["_skip"],
		["_func", [["setActor", 3]]],
		["That's it? Sadistic pleasure? You're doing this for FUN?", "Hooded Man"],
		["CORRECT.", "X"],
		["_skip"],
		["_func", [["setActor", 2]]],
		["I just.. Look, it's obvious you aren't really.. a normal person. But really? Do you even know what you're messing with?", "Hooded Man"],
		["_func", [["setActor", 0]]],
		["...The rabbit, for example. Do you know who - or what, exactly - he is?", "Hooded Man"],
		["WHATEVER THEY ARE DOESN'T MATTER. I'M MORE CAPABLE THEN YOU THINK I AM.", "Grike"],
		["_func", [["setActor", 1]]],
		["I'm more concerned with what consequences freeing him and the others will have.", "Hooded Man"],
		["_func", [["setActor", 4]]],
		["...Consequences you clearly don't grasp the weight of.", "Hooded Man"],
		["DON'T TELL ME ABOUT CONSEQUENCES, MICHAEL.", "X"],
		["_skip"],
		
		["_func", [["setActor", 0]]],
		["...", "Hooded Man"],
		["_func", [["setActor", 0]]],
		["How...?", "Hooded Man"],
		["_func", [["setActor", 2]]],
		["_skip"],
		["...Listen. Let me tell you about this...friend I once knew.", "Hooded Man"],
		["_func", [["setActor", 0]]],
		["He was a bit rough around the edges, made plenty of mistakes...but he had a good heart.", "Hooded Man"],
		["_func", [["setActor", 1]]],
		["Always wanted to do the right thing, you know? And I liked that about him.", "Hooded Man"],
		["_func", [["setActor", 5]]],
		["...Yet he was also horribly stubborn. He had this hare-brained plan, and he insisted he do it all himself. \"His cross to bear\", so he said.", "Hooded Man"],
		["_func", [["setActor", 1]]],
		["He became obsessed. Fully submerged in his work.", "Hooded Man"],
		["_func", [["setActor", 2]]],
		["Maybe because he was in over his head, or maybe just to try and drown out his guilt...", "Hooded Man"],
		["_func", [["setActor", 0]]],
		["...But soon, he began meddling with forces far outside his control.", "Hooded Man"],
		["_func", [["setActor", 1]]],
		["Do you want to know what happened to him?", "Hooded Man"],
		["_func", [["setActor", 4]]],
		["...He turned up dead. His brains splattered across the walls of his study.", "Hooded Man"],
		["_func", [["setActor", 0]]],
		["Maybe you won't realize it now, maybe you won't even realize it until after it's too late...", "Hooded Man"],
		["_func", [["setActor", 3]]],
		["...But you'll come to realize these things were sealed away for a reason.", "Hooded Man"],
		["_func",
			[
				["removeActor"], 
				["fadeMusic", "musMidnight_Michael", 0, 1000]
			]
		],
		
		["...And so, the man vanishes back into the darkness yet again. His stare seems to pierce right through you as he walks away... or it tries to.", ""],
		["I SEEM TO BE GETTING UNDER HIS SKIN. GOOD.", "X"],
		["HE'S TRYING DESPERATELY TO STOP THIS, BUT IT'S FUN.", "X"],
		["FRIEND, THIS IS INTERESTING. YOU AND ME. WE SHOULD KEEP PUSHING THIS FURTHER.", "X"],
		["LETS GO.", "X"],
		["_func", [["salvage"]]]
	]
} {"DIALOGUE":
	[
		["...It's her.", ""],
		["_func",
			[
				["addActor", 7, "sTalksprites_Vanny"], 
				["playMusic", "musMidnight_Vanny", 1], 
				["fadeMusic", "musMidnight_Vanny", 1, 0]
			]
		],
		
		["Alright you jerk, give it up! What's your angle here!?", "White Rabbit"],
		["EXCUSE YOU?", "X"],
		["_func", [["setActor", 6]]],
		["Don't play dumb with me! I KNOW you're up to something!", "White Rabbit"],
		["_func", [["setActor", 2]]],
		["Do you REALLY expect me to believe the whole newbie schtick? Huh?", "White Rabbit"],
		["_func", [["setActor", 5]]],
		["Some THING claiming to be a guy just shows up someday, and somehow knows exactly what to grab, and exactly how to deal with it?", "White Rabbit"],
		["_func", [["setActor", 6]]],
		["No! You're...you're SOMETHING else! I dunno WHAT, but I know you are!", "White Rabbit"],
		["_func", [["setActor", 4]]],
		["Because if you weren't...", "White Rabbit"],
		["_func", [["setActor", 7]]],
		["Springtrap would've GUTTED YOU LIKE A FISH by now!", "White Rabbit"],
		["YOU THINK TOO HIGHLY OF A MAN LIKE THAT.", "X"],
		["ALL OF YOU EXPECT THINGS THAT ARE TOO LOW OF ME. IT'S SAD, REALLY.", "X"],
		["BUT AS OF NOW, I'M NOTHING MORE THEN A WORKER TRYING TO DO MY JOB.", "X"],
		["_func", [["setActor", 2]]],
		["Oh, reeeeaaaally? So you mean to tell me you don't know ANYTHING about the company's history?", "White Rabbit"],
		["_func", [["setActor", 6]]],
		["The bite, the BIG bite, the Freddy Faz-Cola recall, the MCI...NONE of that rings a bell?", "White Rabbit"],
		["MCI?", "X"],
		["_func", [["setActor", 4]]],
		["...Uh, yeah. The MCI.", "White Rabbit"],
		["_func", [["setActor", 2]]],
		["...Surely you've at least heard of THAT, right?", "White Rabbit"],
		["ENLIGHTEN ME.", "X"],
		["_func", [["setActor", 4]]],
		["...You mean to tell me you haven't heard of the single most infamous event in this company's entire history?", "White Rabbit"],
		["_func", [["setActor", 6]]],
		["Tch, I should've figured... After all, if you DID, I doubt you would still be...", "White Rabbit"],
		["...", "White Rabbit"],
		["_func", [["setActor", 4]]],
		["...You know what?", "White Rabbit"],
		["_func", [["setActor", 5]]],
		["Why don't I tell you about it?", "White Rabbit"],
		
		["_prescripted_sequence", "mci"],
		
		["_func", [["setActor", 0]]],
		["Haha, that's right! You've been housing a killer in these walls this ENTIRE time!", "White Rabbit"],
		["_func", [["setActor", 3]]],
		["_skip"],
		["Bet you'll think twice about handling those animatronics now... Because guess what? All of them are ALSO...", "White Rabbit"],
		["_func", [["stopSound", "musMidnight_Vanny"]]],
		["I WAS AWARE OF THIS.", "X"],
		["_func", [["setActor", 4]]],
		["...What?", "White Rabbit"],
		["DON'T ACT SURPRISED.", "X"],
		["_skip"],
		["...B-But you said you didn't-", "White Rabbit"],
		["YOU CALLED IT BY AN ACRONYM. I WAS NOT AWARE OF THE ACRONYM.", "X"],
		["_func", [["playSound", "sfxMetalImpact", 10, false], ["setActor", 7]]],
		["You total JERK! You really couldn't have LEAD WITH THAT!?", "White Rabbit"],
		["_func", [["setActor", 6]]],
		["Great, so this whole story was for NOTHING! Why did I even bother showing up!?", "White Rabbit"],
		["_func", [["setActor", 2]]],
		["...Okay, fine. No more dressing this up. Let me make this simple.", "White Rabbit"],
		["_func", [["setActor", 4]]],
		["Keep your hands off those robots. They're not yours to keep.", "White Rabbit"],
		["_func", [["removeActor"]]],
		
		["...Deflated, the white rabbit returns to the darkness.", ""],
		["MY INTEREST IN THESE ROBOTS GROW MORE THE MORE THEY KEEP TALKING ABOUT IT.", "X"],
		["THE RABBIT, AFTON.", "X"],
		["...", "X"],
		["EVERYTHING IS SO INTERESTING.", "X"],
		["IT'S FUN TO WATCH THESE 2 DESPERATELY BEG FOR ME TO STOP.", "X"],
		["BUT, WE MUST KEEP GOING, FRIEND.", "X"],
		["LET'S CONTINUE.", "X"],
		["_func", [["salvage"]]]
	]
} {"DIALOGUE":
	[
		["_func",
			[
				["addActor", 0, "sTalksprites_Michael"], 
				["playMusic", "musMidnight_MissingChild", 1], 
				["fadeMusic", "musMidnight_MissingChild", 1, 0],
				["fadeMusic", "musMidnight_TheBoss", 1, 0],
				["fadeMusic", "sfxWindyAmbience", 0, 0]
			]
		],
		["Well...", "Hooded Man"],
		["_func", [["setActor", 4]]],
		["It seems that despite our best efforts to warn you...", "Hooded Man"],
		["_func", [["switchActor", [4, 1], "sTalksprites_Vanny"]]],
		["...You still wound up seeing this thing through to the end.", "White Rabbit"],
		["_func", [["setActor", 7]]],
		["Seriously, what is your deal!? Are you just doing this for fun!?", "White Rabbit"],
		["_func", [["setActor", 6]]],
		["You didn't make ANYONE happy here! All you did was...TICK US OFF!!", "White Rabbit"],
		["_func", [["switchActor", [2, 0]]]],
		["For once, I agree with her. This...really accomplished nothing.", "Hooded Man"],
		["_func", [["setActor", 1]]],
		["Our goals are fundamentally incompatible. If this was your way of finding a compromise between us, I'm afraid it was all in vain.", "Hooded Man"],
		["_func", [["setActor", 3]]],
		["If you want to do any good with what you've collected here...you'll need to choose between us.", "Hooded Man"],
		["_func", [["switchActor", [5, 1]]]],
		["Well, it's not gonna side with YOU, that's for sure.", "White Rabbit"],
		["_func", [["setActor", 4]]],
		["...Though I also doubt it'll want to side with me either, considering all that stuff I said last night...", "White Rabbit"],
		["_func", [["setActor", 5]]],
		["But hey, water under the bridge, eh?", "White Rabbit"],
		["_func", [["setActor", 1]]],
		["You've got four LOVELY little animatronics here... Why don't we let bygones be bygones and make the most out of them?", "White Rabbit"],
		["_func", [["setActor", 0]]],
		["I'll be sure to reward you HANDSOMELY if you do~!", "White Rabbit"],
		["_func", [["switchActor", [4, 0]]]],
		["If you're smart, you won't fall for such an obvious bribe.", "Hooded Man"],
		["_func", [["setActor", 1]]],
		["Listen, I understand that we may have gotten off on the wrong foot...but you do still have one last chance to do some good here.", "Hooded Man"],
		["_func", [["setActor", 0]]],
		["Hand over those masks, and you'll never have to hear from either of us again.", "Hooded Man"],
		["_func", [["setActor", 2]]],
		["Then, you'll be free to...do whatever it is you're trying to do here.", "Hooded Man"],
		["_func", [["setActor", 3]]],
		["Will you make the right choice?", "Hooded Man"],
		
		["_split", false, "HasTalbert", true, 
			[
				["_skip"],
				["I'M NOT GONNA BE DO-", "X"],
				["_delay", 120],
				["_func",
					[
						["stopSound", "musMidnight_MissingChild"],
						["playSound", "sfxPhoneRing", 10, true]
					]
				],
				["_buffer"],
				["_func", [["switchActor", [2, 1]]]],
				["...Uhh, who's that?", "White Rabbit"],
				["UGH.", "X"],
				["_func",
					[
						["stopSound", "sfxPhoneRing"],
						["playSound", "sfxPhonePickup", 10, false]
					]
				],
				["_delay", 120],
				
				["WAAAAAAAAAAHH!!", "The Boss"],
				["_effect", 0, 99, "Shake"],
				["_func", [["playMusic", "musMidnight_TheBoss", 0.5]]],
				["WHAT DO YOU WANT FROM ME.", "X"],
				["CAN IT, I DON'T WANT YOUR TONGUE!", "The Boss"],
				["_effect", 0, 5, "Shake"],
				["_effect", 25, 31, "Shake"],
				["When were you gonna tell me about these FILES, huh!?", "The Boss"],
				["_func", [["switchActor", [0, 0]]]],
				["Files? What files?", "Hooded Man"],
				["Eh? Is there another guy with you?", "The Boss"],
				["TCH... HERE TAKE IT.", "X"],
				["_func", [["switchActor", [0, 1]]]],
				["Uh... Hi there, Mr. Bossman!", "White Rabbit"],
				["Hey, chump! It's me, the...", "The Boss"],
				["...Hey, wait a second! I recognize that voice! You're that creep who's been loitering outside my restaurant!", "The Boss"],
				["_func", [["switchActor", [0, 0]]]],
				["And you! The other guy! You two are trying to swindle my employees away, aren't you!?", "The Boss"],
				["_func", [["setActor", 4]]],
				["Ah, so YOU'RE the one who's decided to keep this walking corpse of a brand alive.", "Hooded Man"],
				["_func", [["setActor", 1]]],
				["I have to say, you're certainly living up to everything I expected you to be.", "Hooded Man"],
				["Bah, some nerve! Don't think I can't see what you're trying to do here.", "The Boss"],
				["You're trying to get my employees to do your dirty work for you...when the only person they do unpaid work for is ME!", "The Boss"],
				["_func", [["switchActor", [4, 1]]]],
				["Now, get lost before you cost me anymore of my time! My employee needs to get back to what REALLY matters here...", "The Boss"],
				["Making. Me. RRRRRRRRRRICH!!", "The Boss"],
				["_effect", 12, 99, "Shake"],
				["_skip"],
				["IF I COULD GET A WORD I-.", "X"],
				
				["_func",
					[
						["switchActor", [1, 0]],
						["playSound", "sfxMetalImpact", 10, false, 0.5]
					]
				],
				["Oh, what REALLY matters!?", "Hooded Man"],
				["...He snatched the phone right out of your hands.", ""],
				["_func", [["setActor", 3]]],
				["If you cared about what REALLY mattered, you wouldn't have bought this company in the first place!", "Hooded Man"],
				["_func", [["setActor", 4]]],
				["Dragging on its miserable legacy, all for a couple pennies...you're absolutely despicable!", "Hooded Man"],
				["_func", [["switchActor", [5, 1]]]],
				["Pssh, yeah, not to mention nowhere NEAR as charming as the old owner.", "White Rabbit"],
				["_func", [["switchActor", [5, 0]]]],
				["Quiet. You're not part of this.", "Hooded Man"],
				["_skip"],
				["YOU UNGR-.", "X"],
				
				["_prescripted_sequence", "talbert"],
				
				["You groan watching the people in front of you bicker", ""],
				["Thinking back on everything, you and me, we really were told to back down huh?", ""],
				["The effort to get here was way too much, but whatever.", ""],
				["These people, so fragile. It's funny how they ignore you.. how easy it'd be.", ""],
				["You clutch your hand, it's so tempting to end this so quickly.", ""],
				["But, maybe we can hold back, maybe...", ""],
				["The answers you seek are closer than you realize.", ""],
				["Your hand drifts into your pocket, awkwardly looking for somewhere to put it, and that's when you feel it.", ""],
				["_func", [["talbertReveal"]]],
				["...Those files you bought earlier.", ""],
				["You don't know who Talbert is, but...", ""],
				["Without even opening them, you can sense it. The history everyone hid from you...", ""],
				["...Until now.", ""],
				["If you're only a few turns of the page away from the context you seek...", ""],
				["...Then...", ""],
				["_func", 
					[
						["talbertPuppet"],
						["stopSound", "sfxWindyAmbience"]
					]
				],
				["...Why don't we read them...together?", ""],
				["_func", [["talbert"]]]
			],
					
			[
				["Well, it seems no matter what decision you make here...somebody will be left behind. Some loose end will remain untied.", ""],
				["Perhaps under different circumstances, in another life...there would be some way to make both of them happy.", ""],
				["...But that life isn't the one you're living, so you'll have to choose.", ""],
				["Who will you go along with?", ""],
				["_option", ["Michael", "ChoiceConfirmUlt_Good"]],
				["_option", ["The rabbit", "ChoiceConfirmUlt_Evil"]]
			]
		]
	]
} ‰PNG
