				["fadeMusic", "musMidnight_Michael", 1, 0]
			]
		],
		
		["Ah, good to see you again. You found the third one.", "Michael"],
		["_func", [["setActor", 4]]],
		["...Which should mean only one remains. As much as I would like to say it's smooth sailing from here, you know how things are with this company by now.", "Michael"],
