				],
				["_func", [["removeActor"]]], 
				["...And off she goes.", ""]
			],
					
			[
				["_split", false, "IsGood", true, 
					[
						["...It looks like someone else is here.", ""],
						["_func", [["addActor", 0, "sTalksprites_Michael"]]],
						["...Thank you for making the right decision.", "Hooded Man"],
						["_split", true, "Night", 3,
							[
								["_func", [["setActor", 2]]],
								["That girl can be...a bit much, can't she?", "Hooded Man"],
								["_func", [["setActor", 0]]],
								["Regardless, I suppose I ought to properly introduce myself. My name is Michael.", "Michael"],
								["_func", [["setActor", 3]]],
								["If it isn't too much trouble, I ask that you continue to collect those masks.", "Michael"],
								["_func", [["setActor", 2]]],
								["...You ARE already halfway there, so I imagine it won't be too difficult.", "Michael"],
								["_func", [["setActor", 1]]],
								["I understand last night may have not been the best introduction...but if you do choose to help me with this, I would be immensely grateful.", "Michael"],
								["_func", [["setActor", 3]]],
								["...I hope to see you make the right choice.", "Michael"]
							],
							
							[
								["_split", true, "Night", 4,
									[
										["_func", [["setActor", 2]]],
										["I must apologize if I came off as rude last night...I just felt I needed to be a bit firm if I were to fully convince you.", "Hooded Man"],
										["_func", [["setActor", 1]]],
										["...And, well...it worked in the end, didn't it?", "Hooded Man"],
										["_func", [["setActor", 2]]],
										["...There IS only one left, so I imagine it won't be too difficult.", "Hooded Man"],
										["_func", [["setActor", 1]]],
										["I understand the last few nights may have not been the best introduction...but if you do choose to help me with this, I would be immensely grateful.", "Hooded Man"],
										["_func", [["setActor", 3]]],
										["...I hope to see you make the right choice.", "Hooded Man"]
									],
									
									[
										["_func", [["setActor", 2]]],
										["...I would've certainly liked if you had made it about three nights sooner, but I suppose I can't complain.", "Hooded Man"],
										["_func", [["setActor", 0]]],
										["Regardless, I suppose I ought to properly introduce myself. My name is Michael.", "Michael"],
										["_func", [["setActor", 2]]],
										["...And if it's not too much trouble, I have a small request.", "Michael"],
										["_func", [["setActor", 3]]],
