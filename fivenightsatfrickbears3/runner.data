						["_func", [["setActor", 1]]],
						["So I'll be seeing you around, my brand new bestie! Mwwwwah!", "White Rabbit"]
					],
					
					[
						["_split", true, "Night", 4,
							[
								["_func", [["setActor", 3]]],
								["That other guy is just SUCH a jerk, right? I couldn't BELIEVE he was talking to you like that!", "White Rabbit"],
								["_func", [["setActor", 5]]],
								["...Oh yeah, I was watching your conversation with him from the bushes last night, hope you didn't mind.", "White Rabbit"],
								["_func", [["setActor", 3]]],
								["Well, whatever! Now that HE'S out of the picture, you can get back to what REALLY matters here!", "White Rabbit"],
								["_func", [["setActor", 0]]],
								["There's only one more of these things left for you to collect. Be a doll and pick it up for me, will you?", "White Rabbit"],
								["_func", [["setActor", 5]]],
								["I'll be sure to reward you HANDSOMELY if you do~!", "White Rabbit"]
							],
							
							[
								["_func", [["setActor", 2]]],
								["...I'm honestly a little surprised by that, considering what I told you about last night...but hey, I'm not one to complain!", "White Rabbit"],
								["_func", [["setActor", 5]]],
								["You know...I think you deserve a reward! Why don't you come back here tomorrow? I promise it'll be worth it!", "White Rabbit"],
